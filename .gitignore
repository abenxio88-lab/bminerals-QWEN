```gitignore
# Build artifacts
*.css.map
.sass-cache/
.cache/

# Dependencies
node_modules/
bower_components/

# Logs
*.log

# Environment
.env
.env.local
.env.*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.Python
*.egg-info/
.eggs/

# Node
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Distribution
dist/
build/
target/
*.min.js
*.min.css

# Compression
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```